{
  "name": "Mobile Codespace",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "forwardPorts": [4173],
  "portsAttributes": {
    "4173": {
      "label": "Mobile Codespace Backend",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "npm install -g @openai/codex@latest --include=optional && npm run check",
  "postStartCommand": "bash .devcontainer/start-mobile.sh",
  "customizations": {
    "vscode": {
      "settings": {
        "workbench.startupEditor": "none"
      }
    }
  }
}
