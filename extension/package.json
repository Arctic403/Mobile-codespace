{
  "name": "mobile-codespace-profile",
  "displayName": "Mobile Codespace Overlay",
  "description": "A full phone-first workbench overlay for GitHub Codespaces.",
  "publisher": "arctic403",
  "version": "2.0.0",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mobileCodespace.open",
        "title": "Mobile: Open Full Overlay"
      },
      {
        "command": "mobileCodespace.home",
        "title": "Mobile: Home"
      },
      {
        "command": "mobileCodespace.files",
        "title": "Mobile: Files"
      },
      {
        "command": "mobileCodespace.search",
        "title": "Mobile: Search"
      },
      {
        "command": "mobileCodespace.git",
        "title": "Mobile: Git"
      },
      {
        "command": "mobileCodespace.terminal",
        "title": "Mobile: Terminal"
      },
      {
        "command": "mobileCodespace.codex",
        "title": "Mobile: Codex"
      }
    ]
  }
}
